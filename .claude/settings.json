{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR/.\" && { [ -d node_modules ] || exit 0; } && npx tsc --noEmit 1>&2 || exit 2",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make e2e)",
      "Bash(npm run verify)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.sentry)"
    ]
  },
  "enabledMcpjsonServers": [
    "supabase"
  ]
}
